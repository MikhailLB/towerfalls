<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification icon: flame / fire — white mono vector.
  Android ignores fill color and uses only the alpha channel for the tray
  icon shape; the system applies the tint automatically.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Outer flame body -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="
M12,1
C12,1 7,6 7,10
C7,10 5,8 6,6
C6,6 3,9 3,13
C3,17.4 7.1,21 12,21
C16.9,21 21,17.4 21,13
C21,9 18,6 18,6
C19,8 17,10 17,10
C17,6 12,1 12,1Z"/>

    <!-- Inner highlight core (semi-transparent for depth) -->
    <path
        android:fillColor="@android:color/white"
        android:alpha="0.45"
        android:pathData="
M12,6
C12,6 9.5,9.5 9.5,12
C9.5,12 8.5,11 9,9.5
C9,9.5 7.5,11 7.5,13.5
C7.5,16.5 9.5,18.5 12,18.5
C14.5,18.5 16.5,16.5 16.5,13.5
C16.5,11 15,9.5 15,9.5
C15.5,11 14.5,12 14.5,12
C14.5,9.5 12,6 12,6Z"/>

</vector>
